# Copy to .env and fill in values for your machine/environment.
# .env is gitignored on purpose - values differ between local dev and each server.

# --- ClickHouse ---
# Local dev: leave unset - defaults to the bundled `clickhouse` container
# (docker-compose.yml), started only when COMPOSE_PROFILES=local (see below).
# Real deployment: point these at the real cluster, e.g.:
#   CLICKHOUSE_HOST=10.207.252.113
#   CLICKHOUSE_PORT=8123
#   CLICKHOUSE_USER=<user>
#   CLICKHOUSE_PASSWORD=<password>
#   CLICKHOUSE_DB=ccai_db
# and leave COMPOSE_PROFILES unset there so the local container doesn't start.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=

# Starts the bundled local ClickHouse container (see docker-compose.yml). Leave
# this UNSET on a real deployment - CLICKHOUSE_HOST above points at the real
# cluster instead, and the local container isn't needed.
COMPOSE_PROFILES=local

# --- LLM ---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# --- Embedding ---
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_BASE_URL=
EMBEDDING_SIZE=1536

# --- Data directory (host-side) ---
# Host folder bind-mounted into the backend container at /data. It holds
# business_knowledge.json, schemas.json, sql_examples.json, system_prompts.json
# and all runtime logs - kept OUTSIDE the backend source tree so a `git pull` /
# image rebuild never overwrites live edits made through the Monitor UI, and so
# chat/execution history survives a backend restart.
# Local dev: leave unset, defaults to ./data (repo root, sibling of
# backend/frontend/monitor). Real deployment: point this at real storage, e.g.
# HOST_DATA_DIR=/usr/local/aimkt/data
HOST_DATA_DIR=

# --- Outbound proxy (only needed on networks that require one, e.g. an
# internal server behind a corporate proxy). Leave all three empty/unset on
# local dev - docker-compose defaults them to "" so nothing is proxied.
# Prefixed with APP_ so this is never accidentally picked up from an
# HTTP_PROXY already set in the host shell/CI environment - only an explicit
# value in this .env file takes effect.
# APP_NO_PROXY must list every hostname/IP that should bypass the proxy: the
# docker-compose service names (so containers keep talking to each other
# directly) plus any internal LLM/embedding/ClickHouse IPs you use - including
# CLICKHOUSE_HOST above when it points at an internal cluster. clickhouse_connect
# reads http_proxy/HTTP_PROXY itself (same convention as requests/urllib3) and
# WILL route ClickHouse traffic through the proxy if its host is missing here -
# an internal cluster IP is generally unreachable through an internet-egress
# corporate proxy, so this silently breaks every query until added.
APP_HTTP_PROXY=
APP_HTTPS_PROXY=
APP_NO_PROXY=localhost,127.0.0.1,clickhouse,redis,qdrant,backend,frontend,monitor
